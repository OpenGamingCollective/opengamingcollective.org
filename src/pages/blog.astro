---
import Layout from '../layouts/Layout.astro';
import { blogPosts } from '../data/blog';
---

<Layout title="Blog | Open Gaming Collective">
  <section class="hero">
    <h1>Blog</h1>
    <p class="lead">
      Articles by OGC members covering fundamentals every Linux gaming developer needs.
    </p>
  </section>

  <section class="section">
    <h2>Articles</h2>
    <div class="member-grid">
      {blogPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="card post-card">
          <div class="post-meta">{post.date} — {post.author}</div>
          <h3>{post.title}</h3>
          <p class="post-desc">{post.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .post-card { text-decoration: none; }
  .post-meta { font-family: "JetBrains Mono", monospace; font-size: 0.72rem; color: var(--accent); font-weight: 600; margin-bottom: 0.25rem; }
  .post-card h3 { margin-bottom: 0.5rem; font-size: 1.1rem; }
  .post-desc { font-size: 0.9rem; color: var(--text-muted); margin: 0; line-height: 1.5; }
</style>