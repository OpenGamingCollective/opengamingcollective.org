---
interface Props {
  title: string;
  statement: string;
  url: string;
  buttonText: string;
}
const { title, statement, url, buttonText } = Astro.props;
---
<div class="card">
  <h3>{title}</h3>
  <p>{statement}</p>
  <a href={url} target="_blank" rel="noopener noreferrer" class="tag" style="display:inline-block; margin-top:auto; text-align:center;">{buttonText}</a>
</div>